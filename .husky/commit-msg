#!/bin/sh

# Sanitize commit message (replace em-dash with hyphen) then run commitlint
HOOK_MSG_FILE="$1"
if [ -f "$(pwd)/tools/sanitize-commit-msg.js" ]; then
  node "$(pwd)/tools/sanitize-commit-msg.js" "$HOOK_MSG_FILE" || true
fi

# Run commitlint to enforce Conventional Commits and header pattern
if command -v npx >/dev/null 2>&1; then
  npx --no -- commitlint --edit "$HOOK_MSG_FILE"
fi
